{
    "pi_default": {
        "image": "ubuntu:latest",
        "overrideFeatureInstallOrder": [
            "./apt-packages",
            "./node",
            "./pi"
        ],
        "features": {
            "apt-packages": {
                "aptPackages": "ca-certificates curl gnupg"
            },
            "node": {
                "nodeVersion": "lts"
            },
            "pi": {
                "piVersion": "latest"
            }
        }
    }
}
