{
    "_global_all-features": {
        "image": "ubuntu:latest",
        "overrideFeatureInstallOrder": [
            "./apt-python",
            "./pipx",
            "./apt-packages",
            "./install-script",
            "./node",
            "./npm-packages",
            "./search-cli-tools",
            "./codex",
            "./pi",
            "./playwright",
            "./pipx-packages",
            "./user"
        ],
        "features": {
            "apt-python": {
                "installPip": true,
                "installPipx": false,
                "installVenv": true
            },
            "pipx": {
                "pipUploadedPriorTo": ""
            },
            "apt-packages": {
                "aptPackages": "ca-certificates curl gnupg tree"
            },
            "install-script": {
                "scriptURL": "https://httpbingo.org/base64/IyEvdXNyL2Jpbi9lbnYgYmFzaApzZXQgLWV1byBwaXBlZmFpbApwcmludGYgJyVzXG4nICIkQCIgPiAvdG1wL2luc3RhbGwtc2NyaXB0LWZlYXR1cmUtYXJncwpwcmludGYgJyVzXG4nICIkR1JFRVRJTkciICIkRFlOQU1JQyIgIiRMSVRFUkFMIiAiJEVNUFRZIiA+IC90bXAvaW5zdGFsbC1zY3JpcHQtZmVhdHVyZS1lbnYK",
                "scriptArgs": "--label \\\"two words\\\" --expanded \\\"\\${HOME##*/}\\\" --literal '\\$HOME' --escaped escaped\\ value --empty ''",
                "envVars": "GREETING='hello world' DYNAMIC=\\\"\\${HOME##*/}\\\" LITERAL='\\$HOME' EMPTY="
            },
            "node": {
                "nodeVersion": "lts"
            },
            "npm-packages": {
                "npmPackages": "markdownlint-cli2"
            },
            "search-cli-tools": {
                "installBrave": true,
                "installContext7": true,
                "installFirecrawl": true,
                "installTavily": true,
                "pipxCooldown": ""
            },
            "codex": {
                "codexVersion": "latest"
            },
            "pi": {
                "piVersion": "latest"
            },
            "playwright": {
                "browser": "chromium"
            },
            "pipx-packages": {
                "pipxPackages": "black",
                "pipxCooldown": ""
            },
            "user": {
                "username": "dev",
                "uid": "1000",
                "gid": "1000"
            }
        }
    }
}
