{
    "codex_default": {
        "image": "ubuntu:latest",
        "overrideFeatureInstallOrder": [
            "./apt-packages",
            "./node",
            "./codex"
        ],
        "features": {
            "apt-packages": {
                "aptPackages": "ca-certificates curl gnupg"
            },
            "node": {
                "nodeVersion": "lts"
            },
            "codex": {
                "codexVersion": "latest"
            }
        }
    }
}
