{
    "name": "APT Python",
    "id": "apt-python",
    "version": "0.1.0-dev",
    "description": "Install default python and optional pip, pipx, and venv apt OS packages.",
    "options": {
        "installPip": {
            "type": "boolean",
            "default": true,
            "description": "Install pip."
        },
        "installPipx": {
            "type": "boolean",
            "default": true,
            "description": "Install pipx. Requires venv to be installed."
        },
        "installVenv": {
            "type": "boolean",
            "default": true,
            "description": "Install venv."
        }
    }
}
