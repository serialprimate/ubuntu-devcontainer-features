{
    "name": "Search CLI Tools",
    "id": "search-cli-tools",
    "version": "0.1.0-dev",
    "description": "Install developer search CLI tools.",
    "options": {
        "installBrave": {
            "type": "boolean",
            "default": true,
            "description": "Install the Brave CLI."
        },
        "installContext7": {
            "type": "boolean",
            "default": true,
            "description": "Install the Context7 CLI."
        },
        "installFirecrawl": {
            "type": "boolean",
            "default": true,
            "description": "Install the Firecrawl CLI."
        },
        "installTavily": {
            "type": "boolean",
            "default": true,
            "description": "Install the Tavily CLI."
        },
        "npmMinReleaseAge": {
            "type": "string",
            "default": "7",
            "description": "Value passed to npm's --min-release-age option in days. An empty string omits the option."
        },
        "pipxCooldown": {
            "type": "string",
            "default": "7",
            "description": "Value passed to pipx's --cooldown option in days. An empty string omits the option."
        }
    }
}
