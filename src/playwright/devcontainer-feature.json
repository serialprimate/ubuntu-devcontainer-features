{
    "name": "Playwright",
    "id": "playwright",
    "version": "0.1.0-dev",
    "description": "Install the Playwright runtime and browser dependency.",
    "containerEnv": {
        "PLAYWRIGHT_BROWSERS_PATH": "/ms-playwright"
    },
    "options": {
        "version": {
            "type": "string",
            "enum": [
                "1.61.1",
                "latest"
            ],
            "default": "latest",
            "description": "Version of the Playwright package to install."
        },
        "browser": {
            "type": "string",
            "enum": [
                "chromium",
                "firefox",
                "webkit"
            ],
            "default": "chromium",
            "description": "Browser to install for Playwright."
        },
        "minReleaseAge": {
            "type": "string",
            "default": "7",
            "description": "Minimum npm release age in days. An empty string completely disables this feature."
        }
    }
}
