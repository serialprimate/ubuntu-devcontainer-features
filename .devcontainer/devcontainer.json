{
    "image": "ubuntu:latest",
    "customizations": {
        "vscode": {
            "settings": {
                "json.schemas": [
                    {
                        "fileMatch": [
                            "src/*/devcontainer-feature.json"
                        ],
                        "url": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainerFeature.schema.json"
                    }
                ]
            },
            "extensions": [
                "mads-hartmann.bash-ide-vscode",
                "ms-azuretools.vscode-containers",
                "github.vscode-github-actions"
            ]
        }
    },
    "features": {
        "ghcr.io/serialprimate/ubuntu-devcontainer-features/apt-packages:0.1.0-dev": {
            "aptPackages": "ca-certificates, curl, fd-find, git, jq, less, openssh-client, ripgrep, tree, unzip, yq, zip"
        },
        "ghcr.io/devcontainers/features/docker-in-docker:4": {
            "version": "latest",
            "moby": false,
            "dockerDashComposeVersion": "none"
        },
        "ghcr.io/serialprimate/ubuntu-devcontainer-features/node:0.1.0-dev": {
            "version": "lts"
        },
        "ghcr.io/serialprimate/ubuntu-devcontainer-features/npm-packages:0.1.0-dev": {
            "npmPackages": "@devcontainers/cli"
        },
        "ghcr.io/serialprimate/ubuntu-devcontainer-features/user:0.1.0-dev": {
            "username": "dev",
            "groups": "docker"
        }
    },
    "remoteUser": "dev"
}
